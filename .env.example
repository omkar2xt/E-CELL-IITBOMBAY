# .env.example — StorePulse AI Cloud & Local Deployment Configuration
# Copy this file to .env and fill in your values
# DO NOT commit real secrets or credentials to git
# Developer: Omkar Gurav

# ── Database Configuration (Neon PostgreSQL & Local SQLite) ───────────
# Application traffic (pooled connection recommended for Neon):
# DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
#
# Schema migrations & DDL (direct unpooled connection for Alembic):
# DIRECT_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require
#
# If DATABASE_URL is unset, StorePulse AI automatically falls back to local SQLite:
# DATABASE_URL=sqlite:///backend/data/storepulse.db

# Connection Pool Limits (Serverless & Persistent Worker)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=300

# ── Vercel Blob Storage (Private Evidence Snapshots) ───────────────────
# Obtained from Vercel Dashboard -> Storage -> Blob -> .env.local
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxxxx
BLOB_ACCESS=private

# ── Runtime & Deployment Environment ──────────────────────────────────
# Set to 1 on Vercel Serverless Function to disable infinite video worker loop:
# SERVERLESS=0
# VERCEL=0

# ── Video Source (Persistent Worker Instance) ─────────────────────────
# Path to retail video file OR webcam index (0, 1, ...)
VIDEO_SOURCE=detection/vid/retail-cctv-footage.mp4

# ── Server & API ──────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
BROADCAST_INTERVAL=5

# ── Privacy & Demographics ────────────────────────────────────────────
DEMOGRAPHICS_ENABLED=false

# ── Retail Analytics Thresholds ───────────────────────────────────────
QUEUE_ALERT_THRESHOLD=3
TRACKING_RETENTION_SECONDS=3600

# ── Frontend Environment (dashboard/.env or Vercel Environment) ───────
# VITE_API_URL=https://your-storepulse-deployment.vercel.app
