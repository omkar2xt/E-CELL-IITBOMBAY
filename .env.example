# .env.example — StorePulse AI
# Copy this file to .env and fill in your values
# Developer: Omkar Gurav

# ── Video Source ──────────────────────────────────────────────
# Path to the video file OR webcam index (0, 1, ...)
VIDEO_SOURCE=detection/vid/retail-cctv-footage.mp4

# ── Server ────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Analytics ─────────────────────────────────────────────────
BROADCAST_INTERVAL=5

# ── Privacy ───────────────────────────────────────────────────
# Set to false to disable demographic estimation (recommended default)
DEMOGRAPHICS_ENABLED=false

# ── Zone Defaults ─────────────────────────────────────────────
# Default queue alert threshold (persons)
QUEUE_ALERT_THRESHOLD=3

# ── Retention ─────────────────────────────────────────────────
# How long (seconds) to keep individual tracking data in memory
TRACKING_RETENTION_SECONDS=3600
